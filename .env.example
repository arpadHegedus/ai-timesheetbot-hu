# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash   # ordered fallback list
GMAIL_USER=                # sender Gmail address
GMAIL_APP_PASSWORD=        # 16-char app password (needs 2-Step Verification): https://myaccount.google.com/apppasswords
REPORT_RECIPIENT=          # who receives timesheets; defaults to GMAIL_USER
RECIPIENT_NAME=            # first name used in the email greeting, e.g. "Hi Caroline,"
COMPANY_NAME=              # printed on the PDF header
EMPLOYEE_NAME=             # printed on the PDF and in the email subject
GOOGLE_CLIENT_ID=          # OAuth Web client ID (see README)
ALLOWED_EMAILS=            # comma-separated whitelist of Google accounts
SESSION_SECRET=
